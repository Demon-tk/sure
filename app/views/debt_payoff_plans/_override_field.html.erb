<%# locals: (plan:, debt:, field:, value:, label:, step:, min: 0, max: nil) %>
<%# One inline GET form per editable cell. Submitting re-runs the plan with
    this value as an override; hidden fields carry the rest of the state so
    edits compose across fields and rows. %>
<%= form_with url: debt_payoff_plan_path, method: :get,
              class: "inline-block",
              data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "blur" } do %>
  <%= hidden_field_tag :strategy, plan.strategy %>
  <%= hidden_field_tag :extra_payment, (plan.extra_payment.positive? ? plan.extra_payment.to_i : nil) %>
  <%= hidden_field_tag :expected_return, sprintf("%g", plan.expected_return.to_f) %>
  <% plan.overrides.each do |account_id, values| %>
    <% values.each do |other_field, other_value| %>
      <% next if account_id == debt.account_id && other_field.to_s == field.to_s %>
      <%= hidden_field_tag "overrides[#{account_id}][#{other_field}]", other_value %>
    <% end %>
  <% end %>
  <%= number_field_tag "overrides[#{debt.account_id}][#{field}]", value,
        min: min, max: max, step: step, placeholder: label, autocomplete: "off",
        aria: { label: label },
        class: "form-field__input w-24 text-sm text-right tabular-nums",
        data: { auto_submit_form_target: "auto" } %>
<% end %>
